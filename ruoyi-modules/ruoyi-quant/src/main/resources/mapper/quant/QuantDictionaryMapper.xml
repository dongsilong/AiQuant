<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.quant.strategy.mapper.QuantDictionaryMapper">
    <select id="countKlinePeriod" resultType="java.lang.Long" timeout="3">
        SELECT COUNT(1)
        FROM sys_dict_data
        WHERE dict_type='quant_kline_period'
          AND dict_value=#{interval}
    </select>
</mapper>
